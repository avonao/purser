{
  "name": "@avonao/purser",
  "version": "0.2.0",
  "description": "Purser CSS: compile-time atomic CSS where overrides, !important and raw colours are impossible, compiled to class names with no style code left in the browser.",
  "license": "MIT",
  "author": "Avonao",
  "homepage": "https://pursercss.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avonao/purser.git"
  },
  "bugs": "https://github.com/avonao/purser/issues",
  "type": "module",
  "keywords": [
    "css",
    "atomic-css",
    "css-in-js",
    "design-tokens",
    "zero-runtime",
    "react",
    "nextjs"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./rule": {
      "types": "./types/index.d.ts",
      "default": "./src/rule.js"
    },
    "./build": {
      "types": "./types/build.d.ts",
      "default": "./src/build/index.js"
    },
    "./compiled": {
      "types": "./types/compiled.d.ts",
      "default": "./src/compiled.js"
    },
    "./compiler": {
      "types": "./types/compiler.d.ts",
      "default": "./src/compiler/index.js"
    },
    "./esbuild": {
      "types": "./types/plugins.d.ts",
      "default": "./src/plugins/esbuild.js"
    },
    "./vite": {
      "types": "./types/plugins.d.ts",
      "default": "./src/plugins/vite.js"
    },
    "./rollup": {
      "types": "./types/plugins.d.ts",
      "default": "./src/plugins/vite.js"
    },
    "./webpack": {
      "types": "./types/plugins.d.ts",
      "default": "./src/plugins/webpack.js"
    },
    "./webpack-loader": "./src/plugins/webpack-loader.cjs",
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "bin": {
    "purser": "./bin/purser.js"
  },
  "files": [
    "bin",
    "src",
    "types",
    "scripts/strike-count.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\" && node --test tests/short/*.test.js",
    "test:update": "UPDATE_GOLDEN=1 node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "bench": "npm --prefix benchmarks run bench"
  },
  "dependencies": {
    "typescript": ">=5.0.0 <7.0.0"
  },
  "peerDependencies": {
    "postcss": ">=8.4"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postcss": "^8.5.6"
  }
}
